{
  "name": "mcp-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "description": "mcp.gholl.com - interactive micro-tool hub for humans and AI agents (MCP Apps)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-embeds.mjs && node scripts/build-og.mjs && node scripts/prerender.mjs",
    "build:web": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:worker": "wrangler dev",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "typecheck:functions": "tsc -p tsconfig.functions.json --noEmit",
    "deploy": "pnpm build && wrangler deploy",
    "types:worker": "wrangler types"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@modelcontextprotocol/ext-apps",
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "dependencies": {
    "@mcp-ui/client": "^7.1.1",
    "@mcp-ui/server": "^6.1.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "echarts": "^6.1.0",
    "katex": "^0.19.0",
    "lunar-typescript": "^1.8.6",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "@eslint/js": "^9.18.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/katex": "^0.16.8",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.11",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0"
  }
}
